# Reeve — environment template. Copy to .env.local for local development.

# Enables the demo identity picker and the role switcher.
# SECURITY: the identity cookie is unsigned, so this flag is the ONLY thing
# standing between a forged cookie and a full platform-admin session.
# It must be unset (or anything other than "1") in every deployed environment.
NEXT_PUBLIC_DEV_IDENTITY=1

# Optional. Without it both copilots stream their deterministic answer instead,
# with identical figures — the LLM only rephrases facts already computed.
# ANTHROPIC_API_KEY=

# Canonical public origin, used by robots.txt and sitemap.xml.
# MUST be set to the real domain before launch.
# NEXT_PUBLIC_SITE_URL=https://example.com

# Production only. NEXT_PUBLIC_DEV_IDENTITY is inlined at build time and cannot
# gate a security decision, so a production build additionally requires this
# server-only, runtime-read flag before it will accept a demo identity cookie.
# Leave unset unless you are deliberately deploying a public demo.
# REEVE_ALLOW_DEMO_IDENTITIES=1
